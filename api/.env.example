# ShowMySkills API Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/showmyskills

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_for_showmyskills_dev_2026

# Client Whitelist & Base URLs (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://showmyskills.xyphx.com,http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# Email Service (Optional for development; OTPs log to console in dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@showmyskills.com
